// Copy to Config/Secrets.xcconfig (git-ignored). Placeholders only. NEVER put a service-role key here.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLIC_ANON_KEY
// Which family member this phone is: you, mom, dad or grandpa (demo family on the server).
GH_MEMBER_ID = you
// Signing for a real iPhone: your Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership)
// and a bundle id nobody else uses. The app group becomes group.<BUNDLE_ID_BASE>.
DEVELOPMENT_TEAM =
BUNDLE_ID_BASE = com.example.goldenhour
