# Public URL where the site will be hosted, e.g. https://example.com (no trailing slash).
# Optional. When set, the build adds canonical, og:url and absolute og:image tags.
# When unset, those tags are omitted rather than pointing at a made-up domain.
VITE_SITE_URL=

# Fill these in once they exist. Each one swaps the primary CTA automatically:
# VITE_APP_STORE_URL=   -> "Download on the App Store"
# VITE_TESTFLIGHT_URL=  -> "Join the TestFlight"
VITE_APP_STORE_URL=
VITE_TESTFLIGHT_URL=
